@echo off
setlocal EnableDelayedExpansion
title [1-CLICK SETUP] OpenSSH Server untuk Hardware and Security Dashboard

:: ============================================================================
:: 0. Auto-Elevate to Administrator
:: ============================================================================
net session >nul 2>&1
if %errorLevel% neq 0 (
    echo [i] Meminta hak akses Administrator...
    powershell -NoProfile -Command "Start-Process cmd.exe -ArgumentList '/c ""%~f0""' -Verb RunAs"
    exit /b
)

color 0B
cls
echo ===============================================================================
echo   [1-CLICK SETUP] AKTIFKAN OPENSSH SERVER TARGET
echo   Enterprise Hardware and Security Dashboard (Agentless Telemetry)
echo ===============================================================================
echo.

:: ----------------------------------------------------------------------------
:: Konfigurasi Port SSH (Opsional Custom Port)
:: ----------------------------------------------------------------------------
set "TARGET_PORT=22"
echo [?] PENGATURAN PORT SSH:
echo     Port standar SSH adalah 22. Jika ingin port custom (misal: 2222), ketik angkanya.
set /p "INPUT_PORT=    Masukkan Port SSH [Tekan ENTER untuk Port 22 default]: "
if not "!INPUT_PORT!"=="" set "TARGET_PORT=!INPUT_PORT!"
set "SSH_TARGET_PORT=!TARGET_PORT!"
echo.
echo [*] Memulai proses instalasi dan konfigurasi pada Port SSH: !TARGET_PORT!...
echo.

:: ----------------------------------------------------------------------------
:: Eksekusi Script PowerShell
:: ----------------------------------------------------------------------------
if exist "%~dp0setup_ssh.ps1" (
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0setup_ssh.ps1"
) else (
    powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
)

echo.
echo ===============================================================================
echo Tekan tombol apa saja untuk menutup jendela ini...
pause >nul
exit /b %errorlevel%
